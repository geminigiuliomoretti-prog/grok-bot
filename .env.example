# Grok Bot - Zero-Cost Dual-Engine Orchestration Configuration

# LLM Routing Mode:
# "hybrid": Routes UI/ComputerUse screenshots & initial planning to Engine A (Gemini 3.8 Flash via OAuth),
#           and intermediate tool execution loops to Engine B (Gemma 4 / Free Key Pool).
# "oauth_first": Prefers Engine A for all requests with failover to Engine B.
# "gemma_only": 100% Engine B via Free Key Pool.
LLM_ROUTING_MODE=hybrid

# ENGINE A (Primary - Google AI Pro OAuth Proxy)
GEMINI_OAUTH_PROXY_URL=http://127.0.0.1:3000/v1
GEMINI_OAUTH_MODEL=gemini-3.8-flash

# ENGINE B (Co-Primary & High-Throughput Free Tier Key Pool)
# Comma-separated list of Gemini / AI Studio Free API keys for 30-90 RPM Round-Robin
GEMINI_FREE_API_KEYS=key1,key2,key3
GEMMA_MODEL=gemma-4-31b-it

# Legacy Fallback Key
GEMINI_API_KEY=your_gemini_api_key_here
